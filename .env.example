# OpenAI key used for card generation and answer grading (server only, never exposed to the browser)
OPENAI_API_KEY=
# Optional: override the model (default: gpt-4.1-mini)
OPENAI_MODEL=

# Turso database (hosted libSQL). For local development you may use file:viva.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional bearer token required by /api/mcp for external MCP clients when set
MCP_API_KEY=

# Budget guards for AI calls
AI_DAILY_CALL_CAP=300
AI_SESSION_DAILY_CAP=40

# Optional: natural voice through Google Cloud Text-to-Speech (falls back to the browser voice when unset)
GOOGLE_TTS_API_KEY=
# Optional: voice name (default: en-US-Chirp3-HD-Kore)
GOOGLE_TTS_VOICE=
# Characters of speech per day across all visitors (default 30000, about 900k a month)
TTS_DAILY_CHAR_CAP=30000
